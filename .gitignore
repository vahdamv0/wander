# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Node / Angular
node_modules/
.angular/
web/build/

# The generated API client (web/src/app/api/) IS committed on purpose: it keeps
# the Docker build and a fresh clone hermetic, with no database needed to
# produce the spec first. CI regenerates it and fails on any drift, so it cannot
# quietly diverge from the Java contract. Never hand-edit it.

# Playwright
web/test-results/
web/playwright-report/
web/blob-report/

# Local config
.env
*.local

# Scratch handoff notes: this-machine, this-moment state, and the file says so
# itself. Kept on disk, out of the repository.
HANDOFF.md

# Claude Code's working directory. Not just noise: it holds git worktrees — whole
# copies of this repository — so a stray `git add -A` would commit the project
# inside itself.
.claude/

# IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.iml

# OS
.DS_Store

# Database dumps written by the backup sidecar. Never commit these: they are
# the whole database, including password hashes and booking references.
/backups/
