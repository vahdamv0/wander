# The reverse proxy in front of wander, and the one place TLS is decided.
#
# WANDER_SITE_ADDRESS is the whole switch:
#
#   :80                  plain HTTP, no certificates requested  (LAN, a tunnel,
#                        or anything already terminating TLS in front of this)
#   wander.example.com   automatic HTTPS via Let's Encrypt, HTTP redirected
#
# Caddy decides by looking at the address: a hostname gets a certificate, a bare
# port does not. There is no flag to set and nothing to comment out.
#
# Whichever you choose, WANDER_COOKIE_SECURE in .env has to agree — see the note
# there. It is the one thing this file cannot decide for you, because it is the
# application that sets the cookie.

# Metrics collection is off until this is switched on, and the switch is
# separate from serving them: this line makes Caddy *gather* the counters, and
# the `metrics` handler in the block at the bottom is what hands them to a
# scraper. Gathering costs a little memory per server and nothing else.
{
	metrics

	# Name the metrics listener, so the series it generates can be told apart
	# from real traffic and thrown away before they leave the machine.
	#
	# Caddy counts requests to *every* server it runs, the metrics endpoint
	# included, and the Caddy dashboard (grafana.com id 22870) groups by `job`
	# and `instance` only — it never filters on `server`. So without this, a
	# scrape every 30s is 2,880 requests a day added to "Total requests", which
	# on a personal instance is most of the graph. Alloy drops
	# `server="metrics_only"` on the way out; see monitoring/config.alloy.
	#
	# Naming it rather than dropping `srv0` is the point. Caddy numbers unnamed
	# servers by sorting their listen addresses as strings, so `:2020` happens to
	# come before `:443` and `:80` and happens to be `srv0` — a coincidence of
	# lexical ordering that would silently reverse if anything about the
	# addresses changed, and reversing it means dropping the real traffic and
	# keeping the synthetic. The address below is a literal in this file, so a
	# name attached to it is deterministic.
	servers :2020 {
		name metrics_only
	}
}

{$WANDER_SITE_ADDRESS::80} {
	# An allowlist: a path this file does not name is a 404 and never reaches
	# the application.
	#
	# THIS IS A SECOND COPY OF web/src/app/app.routes.ts. Adding a route there and
	# not here 404s the new page, and it does so in the nastiest way available:
	# navigating to it in the app works, because Angular routes client-side and
	# asks the server for nothing; `ng serve` works; the browser suite passes,
	# because it does not run behind this proxy. It breaks only on a reload, a
	# bookmark or a shared link, only in production. There is a pointer back to
	# this file beside the route table.
	#
	# /.well-known has to stay reachable whatever else goes: ACME's HTTP-01
	# challenge lives there, and that is the whole of automatic HTTPS.
	@known {
		# Client routes, in the order app.routes.ts declares them. Each parent is
		# named twice because `/trips/*` does not match `/trips`.
		path /
		path /login
		path /forgot
		path /reset/*
		path /trips /trips/*
		path /invite/*
		path /account
		path /admin

		# The API, which does its own default-deny in SecurityConfig, and the
		# WebSocket live sync rides on (/api/ws/trips/*).
		path /api/*

		# Certificate issuance.
		path /.well-known/*

		# The Angular build and the files in web/public.
		path /index.html
		path /*.js /*.mjs /*.css
		path /media/*
		path /manifest.webmanifest
		path /favicon.ico /favicon.svg /icon.svg
		path /icon-192.png /icon-512.png /icon-maskable-512.png
		path /apple-touch-icon.png
		path /robots.txt

		# The service worker's own manifest. Requested as
		# /ngsw.json?ngsw-cache-bust=... and a query string does not affect a path
		# matcher. ngsw-worker.js and safety-worker.js are matched by /*.js above.
		path /ngsw.json
	}

	handle @known {
		# WebSockets need no configuration here: Caddy passes an Upgrade request
		# through reverse_proxy untouched, which is what live sync rides on. It is
		# the reason this is Caddy and not nginx, where forgetting the Upgrade and
		# Connection headers leaves an app that looks fine and silently stops syncing.
		#
		# X-Forwarded-Proto is set automatically, and the app already trusts it
		# (`server.forward-headers-strategy: framework`), so it knows the request
		# arrived over HTTPS even though it is served plain HTTP inside the network.
		reverse_proxy wander:8080 {
			# Overwrite rather than append, and this line is load-bearing.
			#
			# Caddy's default is to *add* the real client to whatever
			# X-Forwarded-For arrived, so a request sent here with a forged
			# `X-Forwarded-For: 1.2.3.4` reaches the app as `1.2.3.4, <real
			# client>`. The app runs with `server.forward-headers-strategy:
			# framework`, whose ForwardedHeaderFilter takes the *first* entry —
			# so without this, getRemoteAddr() is whatever the caller says it
			# is, and LoginThrottle's per-address counter can be evaded by
			# rotating a header. Binding 8080 to loopback does not help: that
			# stops somebody going around this proxy, and this goes through it.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Everything else. Logged rather than skipped: being scanned is worth seeing,
	# and it is the burst rather than the individual line that says anything.
	handle {
		respond 404
	}

	# The jar serves pre-compressed assets, but the JSON API is not compressed
	# and an itinerary is mostly text.
	encode zstd gzip

	# An invitation token travels in the URL path (/api/invites/<token>), and an
	# access log records paths. The token is the credential — anybody holding it
	# can join the trip — so logging it writes a working key to a file that
	# outlives the link, gets shipped wherever logs are shipped, and is readable
	# by anyone who can read the box. The database deliberately stores only a
	# SHA-256 of it for exactly this reason; leaving it in the log would undo that
	# in the one place nobody thinks to look.
	#
	# The cost is that these requests are invisible in the access log. That is the
	# right way round: the application still logs what it did with an invitation,
	# without the token.
	@invites path /api/invites/*
	log_skip @invites

	log {
		output stderr
		format console
	}

	# A second access logger over the same requests, in JSON, to a file that
	# Grafana Alloy tails. Two loggers rather than one reformatted: `docker
	# compose logs proxy` is how anybody looks at this stack by hand, and a wall
	# of JSON there would make the console log useless to get a machine-readable
	# one. They cost one extra write per request.
	#
	# `log_skip` above applies to the *request*, not to a logger, so the
	# invitation tokens that are kept out of the console log are kept out of this
	# one too — which matters more here, because this file leaves the machine.
	# Do not add a logger expecting it to be exempt.
	#
	# Rolled at 10MiB and kept 3 deep. This file is a buffer for something that
	# ships it elsewhere, not an archive: if Alloy is down for a day the oldest
	# lines are lost rather than the disk filling, which is the right way round
	# on a box whose other job is holding the database.
	log access_json {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}

# Prometheus metrics, on a port nothing publishes.
#
# Caddy already serves /metrics on its admin API, but that API can also *rewrite
# the running configuration*, so reaching it from another container would mean
# putting a remote-control socket on the compose network to read some counters.
# This is a plain site block with one handler on it: it serves metrics and can
# do nothing else, and compose does not map the port, so it is reachable from
# the other containers and from nowhere on the host or the internet.
:2020 {
	metrics

	# Nothing of value, and every scrape would write a line into the file that
	# ships to Grafana Cloud.
	log_skip
}
