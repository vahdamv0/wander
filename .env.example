# Copy to .env for `docker compose up`. Compose reads .env automatically.

# --- required in production -------------------------------------------------
# The Postgres password. Anything but the default before you expose this.
POSTGRES_PASSWORD=change-me

# --- first boot ------------------------------------------------------------
# Leave both blank and wander generates an admin password and prints it once to
# the container log (`docker compose logs wander`).
WANDER_ADMIN_EMAIL=
WANDER_ADMIN_PASSWORD=

# --- instance behaviour ----------------------------------------------------
# Self-signup, and it is OFF by default because that is the right answer for an
# instance anybody can reach: an open sign-up form on a public hostname hands
# this machine's Nominatim, Wikimedia, Open-Meteo and Frankfurter budget —
# donated capacity,
# all of it — to whoever finds the address.
#
# Off does not mean nobody else can join. An invitation link still admits its
# holder: they open the link, the sign-up form accepts them because the token is
# live, and they land back on the invitation. That is the whole journey, and it
# is the only way in, which is what makes this a closed instance rather than a
# sealed one.
#
# Turn it on for a private LAN box, or for a public instance you actually want
# strangers signing up to. The browser suite (`npm run e2e`) creates its accounts
# by registering, so a local instance you run it against needs it on.
WANDER_REGISTRATION_ENABLED=false

# --- the source link -------------------------------------------------------
# wander is AGPL-3.0-or-later, and section 13 is the clause that applies the
# moment you put an instance where other people can reach it: those users are
# owed the source of the version they are talking to. The interface offers it as
# a "Source" link on the sign-in page and in the account menu, and this is where
# it points.
#
# **If you modify wander, change this to your fork.** Leaving it aimed at
# upstream is worse than removing it — it looks like compliance while naming
# code your instance is not running.
#
# Blank hides the link entirely. That is meant for a private box nobody else is
# offered; on a public instance it is most likely a licence violation rather
# than a preference.
#
# Commented out on purpose. Unset, the application links to the project it was
# built from, and a rename upstream travels with the next image. Setting it here
# pins whatever URL was current the day you copied this file — which is right
# for a fork and wrong for everybody else, because a stale link keeps resolving
# until it does not, and nothing fails when it stops.
#WANDER_SOURCE_URL=https://gitlab.com/you/your-wander-fork

# --- sending mail ----------------------------------------------------------
# Off by default, and this is the only upstream in wander with no working public
# option — Nominatim, Open-Meteo and the map tiles all have one, so they just
# work. Mail needs a relay somebody signed up for.
#
# What it buys you is the "Forgot password?" link on the sign-in page. With it
# off, that link is not drawn and the endpoint is not there: the recovery for a
# forgotten password stays an administrator minting a link in /admin and handing
# it over, which is how it has always worked and remains a perfectly good answer
# for an instance with a handful of people on it.
#
# **There is no provider in the code.** Brevo, Gmail, Resend, Postmark, SES or a
# Postfix on the next rack are all SMTP, so switching is these four lines and a
# restart. Two things decide which one works for you:
#
#   - **Port 25 is blocked outbound by every cloud provider**, Oracle included.
#     Use a relay on 587 (STARTTLS) or 465. Do not try to deliver directly.
#   - **The From: address must be one the relay is authorised to send for.**
#     Mail signed by one domain while claiming to come from another is precisely
#     what spam filters catch, and a reset link in a junk folder is
#     indistinguishable from one that was never sent — by the one person who
#     cannot get in to tell you about it.
#
# If you own a domain, verify it with the provider and send from it. If you do
# not, the honest option is Gmail with an app password: it is the only free route
# where the sending domain and the From: domain match without owning one. Use a
# dedicated account, since this password sits in this file on a public-facing box.
#
# Brevo (free plan, 300/day, no card, single-sender verification if you have no
# domain):
#   WANDER_SMTP_HOST=smtp-relay.brevo.com
#   WANDER_SMTP_PORT=587
#   WANDER_SMTP_USER=<the SMTP login Brevo shows you, not your account email>
#   WANDER_SMTP_PASSWORD=<the SMTP key>
#
# Gmail (needs 2FA on the account first, then an app password):
#   WANDER_SMTP_HOST=smtp.gmail.com
#   WANDER_SMTP_PORT=587
#   WANDER_SMTP_USER=you@gmail.com
#   WANDER_SMTP_PASSWORD=<16-character app password>
#
#WANDER_MAIL_ENABLED=true
#WANDER_MAIL_FROM=noreply@example.com
#WANDER_MAIL_FROM_NAME=wander
#WANDER_SMTP_HOST=
#WANDER_SMTP_PORT=587
#WANDER_SMTP_USER=
#WANDER_SMTP_PASSWORD=

# Where the link in the message points. Blank derives it from the request, which
# is right behind a proxy that sets the forwarded headers — the same ones the
# login throttle depends on. Set it if the links come out wrong; unlike a bad
# throttle this failure is visible, because the link simply does not work.
#WANDER_MAIL_BASE_URL=https://wander.example.com

# How long a self-requested link lives, and how many one address may ask for in a
# login window. Minutes rather than the administrator path's days: an emailed
# link is acted on at once or not at all, and it sits in a mailbox that may
# itself be the thing that was compromised. The request limit is the tightest in
# wander because it is the only endpoint that makes something leave the building
# — an unmetered one is a way to post junk at third parties using your relay.
#WANDER_MAIL_RESET_EXPIRES_MINUTES=60
#WANDER_MAIL_MAX_REQUESTS_PER_ADDRESS=5

# --- the demo trip ---------------------------------------------------------
# Seeds one worked example trip — an itinerary with photographs and a map, two
# people splitting expenses, a packing list, and a flight that lands in another
# timezone — and publishes a **read-only** account to look at it with. The
# sign-in page then offers it, credentials and all.
#
# Off by default because it writes rows. It is for a public demo instance; on a
# real one it would put a trip nobody asked for in front of your users.
#
# Three things worth knowing before you switch it on:
#
#  - The published account is a **viewer** on that trip and owns nothing. That
#    is enforced by the server, not by hiding buttons — the same 403 anybody
#    else would get. It cannot leave the trip either — the one write a viewer is
#    normally entitled to, and on a shared login an accident that would take the
#    demo away from everybody after them. It can still create trips of its own,
#    and it shares one upstream quota with everybody using it, which is the
#    reason those limits exist.
#  - **It re-seeds on every boot**, within its own trips only. Restarting the
#    container resets the demo and re-dates the trip — which it needs, because a
#    forecast only exists about sixteen days out.
#  - **Trips the shared account makes for itself are swept every 45 minutes.**
#    That is a different job from the re-seed and it has to be: the seeder's
#    delete is scoped to the demo *content* owner, so a trip created by a visitor
#    survives a restart, a rebuild and a redeploy alike. Everybody signs in as
#    the same account, so without the sweep whatever the last stranger typed sits
#    on the next visitor's trip list until somebody opens psql. It runs once at
#    startup too. WANDER_DEMO_SWEEP_MINUTES must be positive — a shared login
#    with nothing tidying up behind it is not a supported configuration, so 0
#    fails at boot rather than quietly disabling it.
#  - The password is meant to be public. Change it if you like; do not treat it
#    as a secret.
WANDER_DEMO_ENABLED=false
WANDER_DEMO_EMAIL=demo@wander.local
WANDER_DEMO_PASSWORD=demo-traveller
WANDER_DEMO_SWEEP_MINUTES=45

# --- guessing passwords ----------------------------------------------------
# /api/auth/login is the one endpoint an internet-facing instance gets probed on
# without being singled out, so failed sign-ins are counted per account and per
# client address and refused with a 429 past these limits. A success clears both
# counters, so somebody fumbling their own password and then getting it right
# leaves nothing behind.
#
# It is not a lockout: the count is forgotten after the window. That is
# deliberate, because recovering an account here needs an administrator (nothing
# sends mail, so there is no self-service reset — see Accounts in the app), and a
# lockout that outlived its window would be a way for a stranger to keep the real
# owner out until you intervened.
#
# The per-address limit is the looser of the two: a household, an office or a
# mobile network reaches this as one address.
WANDER_LOGIN_MAX_FAILURES=10
WANDER_LOGIN_MAX_FAILURES_PER_ADDRESS=40
WANDER_LOGIN_WINDOW_MINUTES=15

# The per-address half of that only means anything because the proxy overwrites
# X-Forwarded-For (`header_up X-Forwarded-For {remote_host}` in the Caddyfile).
# Caddy's default is to *append* the real client to whatever header arrived, and
# the app reads the first entry — so without that line a caller sets their own
# address and the per-address counter is free to evade. Put a different proxy in
# front of this one and it has to overwrite the header too.

# --- creating accounts -----------------------------------------------------
# How many accounts one address may create in the same window as above.
# Registering is anonymous, spends a bcrypt round every time and leaves a row
# behind when it works, so an unmetered form is both a way to burn this box's
# CPU and a way to fill its user table. Counted whether the sign-up succeeds or
# not, because both cost the same.
#
# The browser suite creates every one of its accounts by registering, all from
# one address, so an instance you point `npm run e2e` at needs this raised —
# the same footnote that already applies to WANDER_REGISTRATION_ENABLED.
WANDER_REGISTRATION_MAX_PER_ADDRESS=20

# --- spending somebody else's budget ---------------------------------------
# Four endpoints reach an upstream on a caller's behalf — place search, place
# enrichment, the forecast and an exchange rate — and every one of them runs on
# donated capacity that belongs to this instance rather than to a user. These
# are the per-person limits, counted per window.
#
# They are the reason self-signup can be turned on at all. Authentication only
# means the person spending the budget has an account, which is not much of a
# hurdle once anybody can make one. And the outbound spacing wander already does
# is not a substitute: it *queues* rather than refuses, so one heavy caller
# without a limit makes everybody else's searches slow instead of their own.
#
# Keyed by user id rather than address, so unlike the login counters above these
# do not depend on the proxy getting X-Forwarded-For right.
WANDER_QUOTA_SEARCHES=120
WANDER_QUOTA_ENRICHMENTS=60
WANDER_QUOTA_FORECASTS=60
# The tightest, and it can afford to be: one lookup per foreign expense somebody
# is typing, over a cache of rates that never expires.
WANDER_QUOTA_RATES=40
# Auto-sorting a day. One click is one matrix, the heaviest question wander
# asks anything, and it is not cached.
WANDER_QUOTA_ROUTES=40
WANDER_QUOTA_WINDOW_MINUTES=5

# --- Content-Security-Policy -----------------------------------------------
# Assembled from the map settings below rather than written out, so an operator
# running their own tile server does not get a blank map. Leave it on.
#
# If your map does draw from somewhere this does not work out on its own, the
# order to do it in is: set REPORT_ONLY=true, load the page, read the console —
# each violation names the origin it blocked — then put those origins in
# EXTRA_SOURCES (space-separated) and set REPORT_ONLY back to false. They are
# appended to connect-src, img-src and font-src.
#
# Report-only is a diagnosis, not a setting to leave on: a policy that only
# reports is a policy that stops nothing.
WANDER_CSP_ENABLED=true
WANDER_CSP_REPORT_ONLY=false
WANDER_CSP_EXTRA_SOURCES=

# --- place search ----------------------------------------------------------
# Searching for places proxies to Nominatim (OpenStreetMap). Set to false on an
# instance with no outbound network access; the itinerary still works, places
# are then typed by hand and have no coordinates.
WANDER_GEOCODING_ENABLED=true
# Point this at your own Nominatim if you expect more than occasional use — the
# public instance allows one request a second and asks that you not build a
# service on top of it.
WANDER_GEOCODING_URL=https://nominatim.openstreetmap.org
# An address the OSM operators can reach you at, sent in the User-Agent. Fill
# this in before running against the public instance.
WANDER_GEOCODING_CONTACT=
# Place names come back in the language the browser asks for. This is only the
# fallback for callers that send no Accept-Language — leave it set, because a
# geocoder with no preference answers in the place's own language (a search for
# Kyoto returns 京都).
WANDER_GEOCODING_LANGUAGE=en

# --- exchange rates --------------------------------------------------------
# An expense paid in something other than the trip's currency is converted once,
# on the way in, and the rate is stored on it and frozen — so a balance never
# mixes currencies and editing an expense later cannot move one.
#
# Rates come from Frankfurter, which needs no API key: the same reason
# Open-Meteo was picked for the forecast, and a self-hoster should not have to
# open an account with a foreign exchange vendor to record a dinner in yen. It
# is MIT-licensed and ships a container, so the URL can point at your own copy.
#
# Setting this to false turns off the **lookup**, not the feature. A foreign
# currency can still be recorded with a rate typed by hand, which is the only
# thing that works on an instance with no outbound network — and is frequently
# the better number, because a card statement knows what was actually charged
# and a market reference does not.
WANDER_FX_ENABLED=true
WANDER_FX_URL=https://api.frankfurter.dev
# Not required by the upstream's licence. Carried for the reason the weather
# credit is: a number somebody is asked to trust should say where it came from.
WANDER_FX_ATTRIBUTION=Exchange rates via Frankfurter
WANDER_FX_ATTRIBUTION_URL=https://frankfurter.dev/

# --- routes ----------------------------------------------------------------
# Auto-sorting a day: wander asks a routing engine how long it takes to get
# between the day's stops, proposes a shorter order, and lets you apply it.
# Three profiles — on foot, driving, cycling — and the finished order opens in
# Google Maps.
#
# **Off by default, and this is the one upstream where that is not caution.**
# The others have a public service anybody may politely use (Nominatim,
# Open-Meteo, Frankfurter, Wikimedia); routing has none. The OSRM project runs a
# demo server, and it is a demo — not capacity to build a self-hosted app on.
#
# What you do have is that OSRM is genuinely easy to run yourself. Download an
# extract from geofabrik.de, prepare it once, and serve it:
#
#   docker run -t -v "$PWD:/data" osrm/osrm-backend osrm-extract -p /opt/foot.lua /data/kansai.osm.pbf
#   docker run -t -v "$PWD:/data" osrm/osrm-backend osrm-partition /data/kansai.osrm
#   docker run -t -v "$PWD:/data" osrm/osrm-backend osrm-customize /data/kansai.osrm
#   docker run -d -p 5000:5000 -v "$PWD:/data" osrm/osrm-backend osrm-routed --algorithm mld /data/kansai.osrm
#
# The profile is a path segment, so one URL serves all three on an engine that
# has all three graphs. A single-graph osrm-backend like the one above ignores
# it and answers the same for each — which is a fine arrangement if everybody
# on the instance is walking.
#
# Nothing about the itinerary depends on this. Off, the button is not drawn and
# the endpoint answers 503; the Google Maps link is built in the browser from
# the coordinates and works either way.
WANDER_ROUTING_ENABLED=false
WANDER_ROUTING_URL=http://localhost:5000
# The matrix is n², and a day with more than a dozen stops is not a day anybody
# is having.
WANDER_ROUTING_MAX_STOPS=12
WANDER_ROUTING_ATTRIBUTION=Routing by OSRM · map data © OpenStreetMap contributors
WANDER_ROUTING_ATTRIBUTION_URL=https://project-osrm.org/
# Gap between outbound calls, in milliseconds. The default suits an engine you
# run yourself, which is what the URL above points at.
#
# **Raise it to 1000 if you point this at somebody else's OSRM.** FOSSGIS runs
# public instances at routing.openstreetmap.de whose terms allow one request a
# second, require a User-Agent naming the application (wander sends one), and
# require the OpenStreetMap attribution plus a link to fixthemap — so the two
# lines above have to change with it:
#
#   WANDER_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
#   WANDER_ROUTING_MIN_INTERVAL_MS=1000
#   WANDER_ROUTING_ATTRIBUTION=Routing by OSRM · data © OpenStreetMap contributors (ODbL) · report an error
#   WANDER_ROUTING_ATTRIBUTION_URL=https://www.openstreetmap.org/fixthemap
#
# Read https://www.fossgis.de/arbeitsgruppen/osm-server/nutzungsbedingungen/
# before you do. Two things it will not fix: each profile is behind its own
# path prefix there (routed-foot, routed-bike, routed-car) and wander has one
# base URL, so all three of its profiles answer from whichever graph you name —
# ask for driving and you get walking times, silently. And FOSSGIS reserve the
# right to withdraw access without notice. Neither is a reason not to use it
# for a household; both are reasons it is not a default.
WANDER_ROUTING_MIN_INTERVAL_MS=200

# --- map ------------------------------------------------------------------
# The map is drawn in the browser, which is the one request wander does not
# proxy. Set enabled=false to hide it entirely; the itinerary is unaffected.
#
# There are two kinds of source, and the style URL wins whenever it is set.
# A style is a MapLibre vector style: the labels arrive as data, so the map can
# be drawn in the reader's language *and* in the local one — a raster tile is a
# picture with the local name already painted into it. The default is
# OpenFreeMap, which needs no API key and no account, and which publishes weekly
# planet dumps if you would rather host it yourself.
#
# Set the style URL blank to fall back to raster tiles from WANDER_MAP_TILE_URL.
# Either way, change the attribution to match whatever you point at: the terms
# attach to the service, not to this code.
WANDER_MAP_ENABLED=true
WANDER_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
WANDER_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark
WANDER_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
WANDER_MAP_ATTRIBUTION=OpenFreeMap · OpenMapTiles · © OpenStreetMap contributors

# --- reading a booking out of a confirmation --------------------------------
# Uploading an email, PDF, HTML page, calendar attachment or Wallet pass and
# having the booking form filled in from it. Importing never writes: it answers
# with drafts and you save them through the ordinary form, so a misread file
# costs a correction on screen rather than a wrong row.
#
# On by default, and there are two readers behind it. The calendar reader is
# pure Java and always present. The document extractor is KItinerary, a binary
# this project's image carries — so an image built without it reports itself as
# calendar-only rather than failing, and /api/config says which you have.
# Switch this off if you would rather nothing on this instance parsed an upload.
WANDER_IMPORT_ENABLED=true

# A cap on the upload, which is the limit that actually matters here: a
# confirmation is an email or a PDF and both are small. The extractor's own
# timeout and output cap sit downstream of it.
WANDER_IMPORT_MAX_FILE_SIZE=5MB
WANDER_IMPORT_MAX_REQUEST_SIZE=6MB

# The extractor is found by probing at startup — the Alpine layout this image
# uses, then Debian's, then PATH — so this is only for an installation the probe
# does not know about.
WANDER_IMPORT_EXTRACTOR_PATH=

# Extra extractor scripts. The image sets this to /app/extractors and carries a
# fix to one of KItinerary's own extractors there; blank loads the 349 built in
# and nothing else, which is what a jar run outside the image gets. Only set it
# if you are running the jar yourself and want those fixes too — see
# extractors/README.md, which sets the bar for what may live there.
#
# Setting it here does nothing on a compose deployment, which is why it is shown
# commented out: compose.yaml deliberately does not pass this one through, since
# a null entry there *unsets* the variable the image itself set. If you are
# running the jar directly, set it in that process's environment instead.
#WANDER_IMPORT_EXTRACTOR_SEARCH_PATH=/path/to/extractors

# A cap on a wedged Qt process rather than a deadline: a tenth of a second is
# typical. The subprocess boundary is the point — a malformed PDF that segfaults
# poppler kills a child, not the instance.
WANDER_IMPORT_TIMEOUT_SECONDS=30
WANDER_IMPORT_MAX_OUTPUT_BYTES=4194304

# --- HTTP or HTTPS ---------------------------------------------------------
# These two lines are the whole switch, and they move together. Caddy decides
# from the address alone: a hostname gets an automatic Let's Encrypt certificate,
# a bare port does not. Nothing else in the stack changes between them.
#
#   HTTP  — a LAN box, a Tailscale/Cloudflare tunnel, or TLS terminated further
#           out. This is the default.
#
#     WANDER_SITE_ADDRESS=:80
#     WANDER_COOKIE_SECURE=false
#
#   HTTPS — a public hostname whose DNS already points at this machine, with
#           ports 80 and 443 reachable so the certificate can be issued.
#
#     WANDER_SITE_ADDRESS=wander.example.com
#     WANDER_COOKIE_SECURE=true
#
# Then: docker compose up -d
#
# Why the cookie flag is not automatic: Caddy terminates TLS, but it is the
# application that sets the cookie, and `secure` tells the *browser* never to
# send it over plain HTTP. Set it true on an HTTP site and you cannot sign in at
# all — the cookie is set and then never sent back.
WANDER_SITE_ADDRESS=:80
WANDER_COOKIE_SECURE=false

# Where the proxy listens on the host. Change if something already has :80.
WANDER_HTTP_PORT=80
WANDER_HTTPS_PORT=443

# --- the app's own port ----------------------------------------------------
# Bound to 127.0.0.1 so it is not a way around the proxy. The browser suite
# drives http://localhost:8080, which still works. WANDER_BIND=0.0.0.0 publishes
# it properly, which you want only if you are not using the proxy at all.
WANDER_BIND=127.0.0.1
WANDER_PORT=8080

# --- backups ---------------------------------------------------------------
# A dump every WANDER_BACKUP_INTERVAL_SECONDS, keeping the newest
# WANDER_BACKUP_KEEP of them. Each dump is read back with `pg_restore --list`
# before it is published, so a corrupt one is caught the day it happens rather
# than the day you need it.
#
# Thirty, not the reflexive seven. Retention is not "how much history do I want",
# it is "how long can something go wrong before the last good copy rotates away" —
# and every dump older than the mistake is a faithful copy of the mistake. A week
# suits software people look at daily. Wander is used hard while a trip is being
# planned and then not opened for months, so the data most likely to be quietly
# damaged is a trip nobody is currently looking at. A dump is a few hundred KB, so
# a month of them costs about ten megabytes and the usual argument for a short
# retention does not apply here.
#
# The directory is a host path, not a named volume, deliberately: `docker compose
# down -v` removes named volumes, and these are the files that most need to
# survive somebody typing that.
#
# This protects against a bad migration, a wrong DELETE, or a corrupted table.
# It does NOT protect against losing the machine — for that, copy the directory
# somewhere else; see README.
WANDER_BACKUP_DIR=./backups
WANDER_BACKUP_INTERVAL_SECONDS=86400
WANDER_BACKUP_KEEP=30

# --- monitoring, and where your visitors are --------------------------------
# Off unless you ask for it, and asking is a compose profile rather than a flag.
# Set this, and every `docker compose` in this directory includes it:
#
#COMPOSE_PROFILES=monitoring
#
# Set it here rather than typing `--profile monitoring` each time, and that is
# not about saving keystrokes. `update.sh` ends with a plain
# `docker compose up -d --no-build`, which selects no profiles — so with the flag
# on the command line instead, every update would restart the four services and
# leave Alloy running on the image it was started with. Nothing would fail: the
# dashboards would keep filling, from a container quietly a release behind.
#
# What runs here is one container, Grafana Alloy. Grafana Cloud hosts the
# Grafana, the Prometheus and the Loki, so none of those are in this stack —
# but Cloud cannot reach into this machine, and publishing Caddy's metrics port
# or its access log so a SaaS could pull from them would be a far worse trade
# than one more container. So Alloy collects locally and pushes out.
#
# Two halves, because no single source answers both questions:
#
#   Metrics  how much traffic, how fast, how many 5xx.  Import dashboard 22870
#            from grafana.com — it wants a Prometheus data source and nothing
#            else.
#   Logs     which country.  Caddy's Prometheus metrics carry server, handler,
#            code and method and nothing geographic, so the country has to come
#            out of the access log, where the address is. Alloy looks it up
#            against a local database and attaches it as a label. Import
#            monitoring/wander-countries.json for the map.
#
# Before the first run, fetch the country database — the lookup has nothing to
# read without it and every request comes back "Unknown":
#
#   ./monitoring/geoip-update.sh
#
# It is CC BY 4.0 from DB-IP, needs no account, and wants refreshing monthly.
# A cron entry is the whole of it:
#
#   0 4 1 * * cd /path/to/wander && ./monitoring/geoip-update.sh
#
# Worth knowing before you switch it on: your access log leaves this machine.
# Alloy redacts the client address from each line first — the country survives,
# because it is looked up here and attached as a label — but the paths, the
# status codes and the timings land on Grafana Labs' servers under their
# retention, not yours. Commenting out one stage in monitoring/config.alloy
# keeps the addresses too, if you would rather have them.
#
# All five come from your Grafana Cloud stack. The two usernames are numeric
# stack ids, not email addresses; getting one wrong answers 401 on every push
# and looks like nothing at all, because the container stays up and the
# dashboard just stays empty.
#
#   Grafana Cloud → your stack → Prometheus → "Details"   URL and user
#   Grafana Cloud → your stack → Loki       → "Details"   URL and user
#   Grafana Cloud → Access Policies                       one token, with
#                                                         metrics:write and
#                                                         logs:write
#
# One token for both: they are the same account and two would be two things to
# rotate.
#GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
#GRAFANA_CLOUD_PROM_USER=1234567
#GRAFANA_CLOUD_LOKI_URL=https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push
#GRAFANA_CLOUD_LOKI_USER=7654321
#GRAFANA_CLOUD_TOKEN=

# What every metric and every log line is tagged with, so a dashboard fed by
# two instances does not add up two sets of traffic. Defaults to
# WANDER_SITE_ADDRESS, which is already the thing that distinguishes one wander
# from another.
#WANDER_MONITORING_INSTANCE=

# --- deploying a built image instead of building here ----------------------
# Leave unset and compose builds from source. Set it and compose pulls, which is
# what a server should do:
#   WANDER_IMAGE=registry.gitlab.com/vm83043-dev/wander:latest
# The registry is private, so the host needs `docker login registry.gitlab.com`
# first with a deploy token that has read_registry.
WANDER_IMAGE=
WANDER_LOG_LEVEL=INFO
