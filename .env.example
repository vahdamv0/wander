# Copy to .env for `docker compose up`. Compose reads .env automatically.

# --- required in production -------------------------------------------------
# The Postgres password. Anything but the default before you expose this.
POSTGRES_PASSWORD=change-me

# --- first boot ------------------------------------------------------------
# Leave both blank and wander generates an admin password and prints it once to
# the container log (`docker compose logs wander`).
WANDER_ADMIN_EMAIL=
WANDER_ADMIN_PASSWORD=

# --- instance behaviour ----------------------------------------------------
# Self-signup. Turn off to make this an invite/admin-created-accounts instance.
WANDER_REGISTRATION_ENABLED=true

# Set to true whenever wander is served over HTTPS (i.e. always, in production).
# The session cookie is then refused over plain HTTP.
WANDER_COOKIE_SECURE=false

WANDER_PORT=8080
WANDER_LOG_LEVEL=INFO
